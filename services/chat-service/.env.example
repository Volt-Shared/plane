# ──────────────────────────────────────────────────────────────────────────────
# Chat-Service Environment Variables
# Copy this to `.env` and fill in real values before running.
# ──────────────────────────────────────────────────────────────────────────────

# Service
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ── Rocket.Chat ───────────────────────────────────────────────────────────────
# Public URL reachable by users' browsers (via the proxy)
ROCKETCHAT_ROOT_URL=http://localhost:8080/chat

# Internal URL used by chat-service to call RC's API (container-to-container)
ROCKETCHAT_URL=http://rocketchat:3000

# Rocket.Chat admin credentials (created on first boot via ADMIN_USERNAME / ADMIN_PASS env vars)
ROCKETCHAT_ADMIN_USERNAME=rocketadmin
ROCKETCHAT_ADMIN_PASSWORD=rocketadmin_secret
ROCKETCHAT_ADMIN_EMAIL=admin@plane.local

# Shared secret for JWT SSO (must match the secret configured in RC admin panel)
# Generate with: openssl rand -hex 64
ROCKETCHAT_JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── MongoDB (Rocket.Chat) ─────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=rocketchat
MONGO_INITDB_ROOT_PASSWORD=rocketchat_secret
# (Used by chat-mongodb container directly — chat-service itself talks to RC via HTTP)

# ── Plane ─────────────────────────────────────────────────────────────────────
# Internal API base — container-to-container
PLANE_API_URL=http://api:8000

# A long-lived Plane API token with admin permissions
# Create via Plane admin panel → Settings → API tokens
PLANE_API_TOKEN=your_plane_api_token_here

# Your Plane workspace slug (visible in the URL: /your-workspace-slug/)
PLANE_WORKSPACE_SLUG=your-workspace-slug

# Secret used to verify incoming Plane webhook signatures
PLANE_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://plane-redis:6379

# ── Sync schedule ─────────────────────────────────────────────────────────────
# Full sync cron expression (default: every 30 minutes)
SYNC_CRON=*/30 * * * *

# ── Chat-Service internal secret ──────────────────────────────────────────────
# Signs tokens issued by the /sso endpoint so only trusted callers can use it
# Generate with: openssl rand -hex 32
CHAT_SERVICE_SECRET=REPLACE_WITH_32_CHAR_HEX_SECRET
